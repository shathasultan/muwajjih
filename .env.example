# Copy to .env and fill in real values. NEVER commit .env -- it is gitignored.

# --- Authentication (required) ---------------------------------------------
# Comma-separated list of accepted API keys.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTENT_API_KEYS=replace-with-a-generated-key

# Set to false ONLY for local development. The service refuses to start if
# this is true while INTENT_API_KEYS is empty.
INTENT_REQUIRE_API_KEY=true

# --- Rate limiting ----------------------------------------------------------
INTENT_RATE_LIMIT_REQUESTS=60
INTENT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Transport --------------------------------------------------------------
# Empty = deny all cross-origin requests. Add origins only if a browser
# client genuinely needs access, e.g. https://app.example.com
INTENT_CORS_ORIGINS=
INTENT_MAX_REQUEST_BYTES=16384

# Set to false on a public deployment to hide the interactive API docs.
INTENT_ENABLE_DOCS=true

# --- Model / service --------------------------------------------------------
INTENT_MODEL_PATH=models/intent_model.joblib
INTENT_CONFIDENCE_FLOOR=0.15
INTENT_LOG_LEVEL=INFO
