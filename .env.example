# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# -- CI scans the full history with gitleaks, so a leaked key fails the build
# even if a later commit removes it.
#
# Every variable is read in exactly one place (src/intent_service/config.py)
# and validated at startup. A misconfigured service refuses to boot with a
# message naming the variable, rather than booting and failing every request.

# --- authentication (REQUIRED) ----------------------------------------------
# Comma-separated. The service refuses to start if auth is required and this is
# empty, so there is no accidental open deployment.
INTENT_API_KEYS=change-me-to-a-long-random-value

# Set to false for LOCAL DEVELOPMENT ONLY.
INTENT_REQUIRE_API_KEY=true

# --- decision policy --------------------------------------------------------
# The automation boundary, as calibrated probabilities:
#   confidence >= AUTO_ROUTE_FLOOR  -> act automatically
#   confidence >= REJECT_FLOOR      -> a human confirms first
#   below that                      -> returned to the sender
# Defaults sit in the measured gap between real messages (>= 0.85) and noise
# (<= 0.34); see BENCHMARKS.md. REJECT_FLOOR must not exceed AUTO_ROUTE_FLOOR
# -- the service refuses to start otherwise, because the human_review band
# would be empty and nothing would ever reach a person.
INTENT_AUTO_ROUTE_FLOOR=0.60
INTENT_REJECT_FLOOR=0.25

# --- decision cache (extension) ---------------------------------------------
# Leave empty to use a bounded in-process cache with no external dependency.
# Set it to run against the Redis in docker-compose.yml.
INTENT_REDIS_URL=
INTENT_CACHE_TTL_SECONDS=300
# Short on purpose: a hung cache must never stall a prediction.
INTENT_CACHE_TIMEOUT_SECONDS=0.25

# --- model ------------------------------------------------------------------
INTENT_MODEL_PATH=models/intent_model.joblib

# --- rate limiting (per API key, or per IP when unauthenticated) ------------
INTENT_RATE_LIMIT_REQUESTS=60
INTENT_RATE_LIMIT_WINDOW_SECONDS=60

# --- transport hardening ----------------------------------------------------
# Empty denies all cross-origin requests -- the safe default for an API with no
# known browser client.
INTENT_CORS_ORIGINS=
INTENT_MAX_REQUEST_BYTES=16384
# Enable ONLY behind a reverse proxy that OVERWRITES X-Forwarded-For. The
# header is caller-controlled otherwise, so trusting it would let anyone reset
# their own rate-limit budget.
INTENT_TRUST_PROXY_HEADERS=false

# --- observability ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are JSON on stdout,
# correlated by trace_id. Message text is never logged at any level.
INTENT_LOG_LEVEL=INFO

# Interactive /docs enumerate every endpoint and schema. Off by default.
INTENT_ENABLE_DOCS=false
